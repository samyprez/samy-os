NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# Server-only. Do not expose with NEXT_PUBLIC_ and do not commit real values.
# WHERE TO FIND IT: Supabase dashboard -> Settings -> API Keys -> "Secret keys".
# The dashboard no longer says "service_role" anywhere — that is the old name for
# this same key. Copy the sb_secret_... value with the copy icon; do not select it
# by hand, and do not grab the project reference id shown nearby.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4.1-mini

# ChatGPT -> Samy OS secure gateway.
# Use a long random token and keep it only in Vercel/ChatGPT Action auth.
# SAMY_OS_API_TOKEN is still accepted as a legacy fallback.
ASSISTANT_API_KEY=replace-with-long-random-secret

# Gmail (leer y enviar correo). Scopes: gmail.readonly + gmail.send only.
# WHERE TO FIND THEM: Google Cloud Console -> APIs & Services -> Credentials ->
# your "Web application" OAuth client. Client ID and secret are shown there;
# add <origin>/api/google/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Minted once by visiting /api/google/auth?token=<ASSISTANT_API_KEY> and copying
# the value the callback page prints. Google only shows it that one time; if you
# lose it, run the flow again. Do not commit it.
GOOGLE_REFRESH_TOKEN=

# Set either the authenticated Samy OS user UUID OR the account email.
# User ID is preferred because it avoids an admin user lookup on each request.
SAMY_OS_OWNER_USER_ID=
SAMY_OS_OWNER_EMAIL=your-email@example.com

# --- WhatsApp notification gateway (POST /api/notifications/whatsapp) --------
# Key that every automation (ChatGPT, n8n, scripts) sends as
# `Authorization: Bearer <NOTIFICATION_API_KEY>`. Long random string, set only
# in Vercel. If missing, ASSISTANT_API_KEY is accepted as a fallback.
NOTIFICATION_API_KEY=replace-with-long-random-secret

# Twilio WhatsApp. Sandbox and production use the same variables; only the
# FROM number changes. WHERE TO FIND THEM: console.twilio.com -> Account Info
# (Account SID, Auth Token) and Messaging -> Try it out -> Send a WhatsApp
# message (Sandbox number, usually +14155238886).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886
# Optional: use a Messaging Service instead of a single FROM number.
TWILIO_MESSAGING_SERVICE_SID=

# Recipient book. Never hard-coded in the app.
SAMY_WHATSAPP=+16474692835
PARTNER_WHATSAPP=
# Any extra person: NOTIFY_WHATSAPP_<ALIAS>, e.g. NOTIFY_WHATSAPP_ANA=+1809...
# Who receives a message that carries no `to`/`recipients` (numbers or aliases).
NOTIFICATION_DEFAULT_RECIPIENTS=samy

# Optional. `twilio` (default) or `meta` to reuse the WhatsApp Cloud API client.
NOTIFICATION_PROVIDER=twilio
# Optional brakes: per-source burst limit and identical-message suppression.
NOTIFICATION_RATE_LIMIT=20
NOTIFICATION_RATE_WINDOW_MS=60000
NOTIFICATION_DEDUPE_WINDOW_MS=60000
